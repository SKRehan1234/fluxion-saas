# MongoDB connection (local or MongoDB Atlas)
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=fluxion

# Optional SMTP credentials. Leave blank to use the development verification link.
# Replace with real credentials to send verification emails.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fluxion <hello@example.com>"
APP_URL=http://localhost:5173
